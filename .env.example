# Fixed HTTPS manifest checked by the installed app on startup.
# dataset-manifest.json may reference questions.json and assets.zip by relative URL.
# Host the distribution files in the same version/deployment directory unless the
# manifest intentionally points elsewhere.
#
# Replace this example before production build. The URL is compiled into the
# frontend; dataset content/version can change later without rebuilding the app.
VITE_DATASET_MANIFEST_URL=https://data.example.com/lythuyetlaixe/dataset-manifest.json
