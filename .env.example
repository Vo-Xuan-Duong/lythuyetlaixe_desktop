# Two independent remote datasets.
# Both URLs are compiled into the frontend. The remote manifests can later point
# to newer immutable versions without rebuilding the app.

# Official 600-question bank distribution.
VITE_QUESTIONS_MANIFEST_URL=https://data.example.com/lythuyetlaixe/questions/manifest.json

# Independent traffic-sign catalog distribution.
VITE_TRAFFIC_SIGNS_MANIFEST_URL=https://data.example.com/lythuyetlaixe/traffic-signs/manifest.json

# Legacy compatibility only. New deployments should use VITE_QUESTIONS_MANIFEST_URL.
# VITE_DATASET_MANIFEST_URL=https://data.example.com/lythuyetlaixe/questions/manifest.json
