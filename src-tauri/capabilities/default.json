{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Quyền tối thiểu cho cửa sổ chính, SQLite local, preference store, notification và cache asset trong AppData",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "store:default",
    "notification:default",
    "fs:create-app-specific-dirs",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        "$APPDATA/dataset-assets",
        "$APPDATA/dataset-assets/**/*"
      ]
    }
  ]
}
