{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lý Thuyết Lái Xe",
  "version": "0.1.0",
  "identifier": "com.voxuanduong.lythuyetlaixe",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lý Thuyết Lái Xe",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/dataset-assets/**/*",
          "$APPDATA/traffic-sign-assets/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Vo-Xuan-Duong"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:lythuyetlaixe.db"]
    }
  }
}
