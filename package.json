{
  "name": "lythuyetlaixe-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:windows": "tauri build --bundles nsis",
    "release:windows:local": "pnpm release:check && pnpm tauri:build:windows",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build:debug": "tauri android build --debug --apk",
    "tauri:android:build:apk": "tauri android build --apk",
    "tauri:android:build:aab": "tauri android build --aab",
    "release:android:apk:local": "pnpm release:check && pnpm tauri:android:build:apk",
    "release:android:aab:local": "pnpm release:check && pnpm tauri:android:build:aab",
    "release:check": "node tools/release/check_versions.mjs",
    "project:status": "node tools/release/preflight.mjs",
    "release:candidate:check": "node tools/release/preflight.mjs --strict",
    "dataset:status": "python tools/dataset/status.py",
    "dataset:review-report": "python tools/dataset/build_review_report.py",
    "dataset:validate": "node tools/dataset/validate.mjs data/processed/questions.json --images-root=data/processed/assets",
    "dataset:metadata": "python tools/dataset/check_source_metadata.py",
    "dataset:download": "python tools/dataset/download_sources.py",
    "dataset:extract": "python tools/dataset/extract_pdf.py",
    "dataset:parse": "python tools/dataset/parse_questions.py",
    "dataset:resolve": "python tools/dataset/resolve_answers.py",
    "dataset:review": "python tools/dataset/apply_answer_review.py",
    "dataset:images": "python tools/dataset/extract_question_images.py",
    "dataset:image-review": "python tools/dataset/apply_image_review.py",
    "dataset:promote": "python tools/dataset/promote_dataset.py",
    "dataset:publish": "pnpm dataset:validate && python tools/dataset/publish_dataset.py",
    "dataset:prepare": "pnpm dataset:metadata && pnpm dataset:extract && pnpm dataset:parse && pnpm dataset:resolve && pnpm dataset:status",
    "dataset:prepare:download": "pnpm dataset:metadata && pnpm dataset:download && pnpm dataset:extract && pnpm dataset:parse && pnpm dataset:resolve && pnpm dataset:status",
    "dataset:after-answer-review": "pnpm dataset:review && pnpm dataset:images && pnpm dataset:review-report && pnpm dataset:status",
    "dataset:finalize": "pnpm dataset:image-review && pnpm dataset:promote && pnpm dataset:publish && pnpm dataset:status",
    "dataset:test": "python -m unittest discover -s tools/dataset/tests -p \"test_*.py\" -v",
    "signs:source:download": "python tools/traffic-signs/download_source.py",
    "signs:source:verify": "python tools/traffic-signs/verify_technical_source.py",
    "signs:candidates:official": "python tools/traffic-signs/extract_official_candidates.py",
    "signs:candidates:images": "python tools/traffic-signs/extract_official_image_candidates.py",
    "signs:candidates:reference": "python tools/traffic-signs/extract_reference_candidates.py",
    "signs:review:prepare": "python tools/traffic-signs/prepare_manual_review.py",
    "signs:review:workspace": "python tools/traffic-signs/build_review_workspace.py",
    "signs:review:images": "python tools/traffic-signs/apply_image_selections.py",
    "signs:review:apply": "python tools/traffic-signs/apply_manual_review.py",
    "signs:status": "node tools/traffic-signs/status.mjs",
    "signs:validate": "node tools/traffic-signs/validate.mjs",
    "signs:publish": "pnpm signs:validate && python tools/traffic-signs/publish.py",
    "signs:finalize": "pnpm signs:review:apply && pnpm signs:publish && pnpm signs:status",
    "signs:test": "python -m unittest discover -s tools/traffic-signs/tests -p \"test_*.py\" -v",
    "data:test": "pnpm dataset:test && pnpm signs:test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.4.4",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.5"
}
